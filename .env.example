# Jupiter — Battery Experiment Planner
# Copy to .env and fill in secrets. Never commit a filled .env.

# --- Nebius Token Factory (NVIDIA Nemotron) ---
# Get a key: https://tokenfactory.nebius.com/  (API keys section)
# Official OpenAI-compatible base URL (confirm in your dashboard):
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Default: Nemotron 3 Nano for fast, everyday calls (hackathon Best Apps track).
# Other catalog IDs (2026-10-27 Token Factory catalog):
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#   nvidia/nemotron-3-super-120b-a12b
#   nvidia/Nemotron-3-Ultra-550b-a55b
#   nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_MAX_RETRIES=2

# Offline demo mode is EXPLICIT. When true, the app labels every LLM
# payload as "offline demo" and never presents it as a successful live call.
# Do not set this to hide missing credentials.
NEBIUS_OFFLINE_DEMO=false

# --- Optional: Materials Project lookup (core workflow works without this) ---
# Dashboard: https://next-gen.materialsproject.org/api
MATERIALS_PROJECT_API_KEY=

# --- App ---
JUPITER_DATABASE_URL=sqlite:///./data/jupiter.sqlite
JUPITER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JUPITER_SEED=42
